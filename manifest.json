{
  "manifest_version": 3,
  "name": "Scrimba Section Progress",
  "version": "0.1.3",
  "description": "Shows the current Scrimba section's progress beside the lesson timer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://scrimba.com/*"],
      "css": ["progress.css"],
      "js": ["progress.js"],
      "run_at": "document_idle"
    }
  ]
}
